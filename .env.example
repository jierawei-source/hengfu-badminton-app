# Supabase project settings (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Used by app/api/leads/route.ts to insert form submissions, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 後台管理系統
# ADMIN_PASSWORD：登入 /admin 用的密碼，自己設定一組即可。
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET：用來簽章登入 session 的隨機字串，越長越亂越好。
# 可以在終端機執行 `openssl rand -hex 32` 產生一組。
ADMIN_SESSION_SECRET=
